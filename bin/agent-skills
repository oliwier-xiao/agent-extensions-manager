#!/usr/bin/env python3
"""agent-skills — the only part of Agent Skills Manager that touches the filesystem.

One line of JSON on stdout, diagnostics on stderr. The QML reads and draws; it does
no I/O of its own beyond spawning this. Every subcommand is runnable by hand, which
is the point: an action you cannot reproduce in a terminal is one you cannot debug.

Exit codes: 0 done · 1 usage error · 2 refused, nothing written. There is no partial-write
code because there is no partial write: the store is built whole, fsynced, and renamed over
the old one, so a failed write leaves the previous file exactly as it was. `remove` is the
one verb that acts on several things at once, and it acts on them one at a time on purpose:
it exits 0 when anything went and names every path that did not, because abandoning the rest
of a batch over one path leaves the user with half a removal and no account of which half.
"""

from __future__ import annotations

import argparse
import errno
import hashlib
import json
import math
import os
import re
import stat
import sys
import time

VERSION = "0.1.0"
HOME = os.path.expanduser("~")

# A skill's SKILL.md is prose. Anything larger than this is not a skill, it is a
# mistake or an attack, and we refuse to read it into memory to find out which.
MAX_READ = 1024 * 1024
FRONTMATTER_LIMIT = 64 * 1024

# Everything below bounds what can cross into the shell process. Quickshell runs
# the whole desktop in one process and StdioCollector has no size cap of its own,
# so the ceiling has to be here, on the producing side, before the bytes exist.
MAX_OUTPUT = 2 * 1024 * 1024
MAX_ITEMS = 2000
MAX_DIR_ENTRIES = 2000
DEADLINE_SECONDS = 20.0


# ---------------------------------------------------------------- safe reading

def _refused(why: list | None, reason: str) -> None:
    """Note down why a read was refused, for the callers that print it.

    safe_read hands back None for six different reasons and an absent file is
    one of them, so a caller that sees only None cannot tell a config that is
    not there from one we would not touch. The difference is the whole message:
    a world-writable settings.json is why every skill would read as `on`, and
    saying nothing about it looks exactly like saying all is well.
    """
    if why is not None:
        why.append(reason)
    return None


def safe_read(path: str, *, max_bytes: int = MAX_READ, why: list | None = None) -> bytes | None:
    """Read a regular file we own, refusing symlinks at the final component.

    O_NOFOLLOW so a swapped symlink cannot redirect us, O_NONBLOCK so a fifo
    cannot hang the panel, and fstat on the descriptor rather than stat on the
    name so the thing we checked is the thing we read. Pass a list as `why` to
    be told which refusal this was; the return stays bytes-or-None either way,
    so a caller with nothing to say about it needs no changing.
    """
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW)
        st = os.fstat(fd)
        # Every decision below is taken on the descriptor we are about to read,
        # never on the pathname. Re-opening a path after checking it is the TOCTOU
        # race the marketplace reviewer rejects even when the checks themselves
        # are correct.
        if not stat.S_ISREG(st.st_mode):
            return _refused(why, "not a regular file")
        # A regular file with more than one link is reachable under a name we did
        # not vet. Refuse rather than read something a hard link redirected.
        if st.st_nlink != 1:
            return _refused(why, "more than one hard link")
        # Root-owned files are the packaged system skills (Omarchy ships its own
        # under /usr/share). Refusing them would silently drop every distro skill.
        # What we refuse is a file owned by some other unprivileged user.
        if st.st_uid not in (os.getuid(), 0):
            return _refused(why, "owned by another user")
        # World-writable means anyone on the machine chooses what we parse.
        if st.st_mode & stat.S_IWOTH:
            return _refused(why, "world-writable")
        if st.st_size > max_bytes:
            limit = (f"{max_bytes // (1024 * 1024)} MiB" if max_bytes >= 1024 * 1024
                     else f"{max_bytes} bytes")
            return _refused(why, f"larger than {limit}")
        os.set_blocking(fd, True)
        # Read to st_size rather than trusting one os.read(). A short read would
        # otherwise hand back a prefix that parses as a whole, valid document.
        chunks = []
        remaining = st.st_size
        while remaining > 0:
            chunk = os.read(fd, min(remaining, 65536))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)
    except OSError as exc:
        if exc.errno not in (errno.ENOENT, errno.ELOOP, errno.EACCES, errno.ENOTDIR, errno.EAGAIN):
            warn(f"read {path}: {exc}")
        # ENOENT and ENOTDIR are silent on purpose. Most machines have no
        # ~/.codex/config.toml and no ~/.config/opencode/opencode.json, and a
        # finding for a file nobody ever claimed exists would fire for nearly
        # every user. Being refused a path that does exist is a different fact.
        # Worth spelling out rather than saying "a symlink": the common way to
        # reach this is a dotfiles manager, where the user made the link on
        # purpose and needs to be told that what it points at went unread --
        # not merely that something was refused.
        if exc.errno == errno.ELOOP:
            return _refused(why, "reached through a symlink, which is not followed")
        if exc.errno == errno.EACCES:
            return _refused(why, "permission denied")
        return None
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def read_text(path: str, *, max_bytes: int = MAX_READ, why: list | None = None) -> str | None:
    raw = safe_read(path, max_bytes=max_bytes, why=why)
    if raw is None:
        return None
    return raw.decode("utf-8", "replace")


def read_json(path: str) -> tuple[dict | list | None, str | None]:
    """Returns (value, error). A malformed config is a finding, not a crash."""
    why: list[str] = []
    txt = read_text(path, why=why)
    if txt is None:
        return None, (f"refused, {why[0]}" if why else None)
    if not txt.strip():
        return None, "empty"
    try:
        return json.loads(txt), None
    except json.JSONDecodeError as exc:
        return None, f"invalid json at line {exc.lineno}"
    except RecursionError:
        # Deeply nested JSON blows the C parser's stack. The docstring promises a
        # finding; without this it was an exit-1 traceback and an empty stdout.
        return None, "json nested too deeply"
    except (ValueError, MemoryError) as exc:
        return None, f"unreadable json: {type(exc).__name__}"


def read_toml(path: str) -> tuple[dict | None, str | None]:
    why: list[str] = []
    raw = safe_read(path, why=why)
    if raw is None:
        return None, (f"refused, {why[0]}" if why else None)
    try:
        import tomllib
        return tomllib.loads(raw.decode("utf-8", "replace")), None
    except Exception as exc:  # noqa: BLE001 - any parse failure is one finding
        return None, f"invalid toml: {exc}"


# A URL query string, a --header argument or an --api-key flag in an MCP command
# line is a credential. The panel draws `target`, so anything secret-shaped is
# replaced here, in the only process that ever sees the original.
#
# What each rule eats is the rest of its argument rather than the rest of the
# word. On the joined command line there is nothing to tell one apart from the
# other, and a header is routinely written `--header X-Api-Key: one two`, so a
# match that stopped at whitespace left two thirds of the key on screen.
_SECRET_WORD = r"(?:header|token|api[-_]?key|password|secret|auth[a-z-]*)"
SECRET_FLAG = re.compile(r"(?i)(--?%s[= ]).*$" % _SECRET_WORD)
SECRET_ENVISH = re.compile(r"(?i)\b([A-Z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD)[A-Z0-9_]*=).*$")
# The same flag written as its own argument, with the value in the next one.
SECRET_FLAG_ALONE = re.compile(r"(?i)^--?%s$" % _SECRET_WORD)
# A scheme and an authority, anywhere in an argument: `npx mcp-remote <url>` is
# how most hosted servers are launched, so the URL is rarely the whole of it.
URL_IN_TEXT = re.compile(r"[A-Za-z][A-Za-z0-9+.-]*://\S*")


def redact(text) -> str:
    """One target string -- a URL, or one argument of a command line."""
    out = clip(text, 512)
    try:
        out = URL_IN_TEXT.sub(lambda m: redact_url(m.group(0)), out)
        out = SECRET_FLAG.sub("\\1\u2026", out)
        out = SECRET_ENVISH.sub("\\1\u2026", out)
    except Exception:
        # A target we could not clean is a target we do not print. No display
        # string is worth failing a scan for, and the ellipsis is honest.
        return "\u2026"
    return out


def redact_argv(argv) -> str:
    """The same, for a command line that has not been joined yet.

    Joining first is what loses the boundary between arguments, and both shapes
    a secret takes need it: a value holding a space is one argument, and
    `--api-key` and its value are two the moment either of them holds one. The
    argv list is intact at every call site, so it is redacted before the join
    rather than after.
    """
    out = []
    value_is_next = False
    for element in argv:
        element = clip(element, 512)
        if value_is_next:
            out.append("\u2026")
            value_is_next = False
            continue
        value_is_next = bool(SECRET_FLAG_ALONE.match(element))
        out.append(redact(element))
    return clip(" ".join(out).strip(), 512)


def redact_url(url: str) -> str:
    """Blank the parts of a URL that carry a key rather than a route.

    Userinfo is a credential outright. The query string goes whole, as it always
    did. The third shape is a token sitting in the path -- `/mcp/<forty opaque
    characters>` -- which several hosted endpoints use in place of a header and
    which reads as an ordinary path segment until you look at its length.
    """
    try:
        # Imported here rather than at the top: it drags in `ipaddress` and costs
        # a third of the scan's whole budget, and most machines have no MCP
        # target with a scheme in it at all.
        import urllib.parse
        parts = urllib.parse.urlsplit(url)
    except Exception:  # noqa: BLE001 - an unparseable target is simply not shown
        return "\u2026"
    if not parts.scheme or not parts.netloc:
        return url
    host = parts.netloc.rsplit("@", 1)[-1]
    if "@" in parts.netloc:
        host = "\u2026@" + host
    path = "/".join("\u2026" if _opaque_segment(s) else s for s in parts.path.split("/"))
    tail = "?\u2026" if parts.query else ""
    if parts.fragment:
        tail += "#\u2026"
    return f"{parts.scheme}://{host}{path}{tail}"


def _opaque_segment(segment: str) -> bool:
    """A path segment long enough to be a key and shaped like nothing else.

    A route is words: `messages`, `streamable-http`, `v1`. A key is one long run
    with digits in it, or a run longer than any word. Judging by length alone
    would redact the longer route names, and judging by shape alone would keep a
    thirty-character base64 blob, so it takes both.
    """
    if len(segment) <= 20:
        return False
    return not all(word.isalpha() and len(word) <= 16
                   for word in re.split(r"[-_.]", segment) if word)


def as_dict(value) -> dict:
    """A config file is user-editable, so every value is the wrong type sooner
    or later. `(x or {})` still hands back a str for {"mcp": "nope"} and the next
    .items() raises; this refuses anything that is not a mapping."""
    return value if isinstance(value, dict) else {}


def as_list(value) -> list:
    return value if isinstance(value, list) else []


def clip(text, limit: int = 512) -> str:
    """Cap every third-party string before it crosses into the shell process."""
    out = "" if text is None else str(text)
    out = "".join(ch for ch in out if ch == "\t" or ch >= " ")
    return out if len(out) <= limit else out[:limit - 1] + "\u2026"


def warn(msg: str) -> None:
    print(f"agent-skills: {msg}", file=sys.stderr)


def tilde(path: str) -> str:
    return "~" + path[len(HOME):] if path.startswith(HOME + "/") else path


# ------------------------------------------------------------- frontmatter

def parse_frontmatter(text: str) -> dict:
    """YAML frontmatter, with a hand-rolled fallback.

    PyYAML is used when present but is NOT assumed: it is not in the Omarchy base
    package set. The fallback handles what actually appears in skill files —
    plain scalars, quoted scalars, block scalars (| and >), and one level of
    nested mapping, which is how `metadata:` is written in the wild.

    A line-oriented `^description:` regex is specifically not enough. Three of
    this machine's own skills (omarchy, diagnose-crash, security-fortress) write
    their description as a multi-line scalar, and a regex reports their token
    cost as 2 to 5 instead of 150, 122 and 123.

    PyYAML is deliberately NOT used even where it is installed. It is absent from
    the Omarchy base package set, so half the users would take a different code
    path from the other half and see different token counts for the same skill —
    and a displayed cost that depends on an optional dependency is worse than a
    slightly simpler parser. It would also lose files outright: this machine's
    n8n-sdk-server writes `Triggers on:` inside an unquoted scalar, which is
    invalid YAML, and PyYAML drops the whole frontmatter rather than the one
    field, reporting a 162-token skill as costing 4.
    """
    if not text.startswith("---"):
        return {}
    end = text.find("\n---", 3)
    if end == -1:
        return {}
    block = text[text.find("\n") + 1:end]
    if len(block) > FRONTMATTER_LIMIT:
        return {}
    return parse_frontmatter_block(block)


# A block scalar's whole header: the style, and the two indicators YAML lets an
# author write after it in either order. Knowing only the chomping half read
# `description: >2` as the literal text ">2 …", which put the indicator into the
# description every agent loads and, once that string had been recorded as the
# author's own, left reset writing it back into the file for good.
#
# The chomping indicator is matched and then deliberately not acted on. All it
# decides is how many newlines survive at the end of the value, and a description
# is one line by the time anyone reads it here: the block is stripped and its
# newlines collapse to spaces. The indentation indicator is the half that changes
# the text itself, so that is the half that is honoured.
BLOCK_SCALAR = re.compile(r"^(?P<style>[|>])"
                          r"(?:(?P<chomp>[+-])(?P<indent>[1-9])?"
                          r"|(?P<indent_first>[1-9])(?P<chomp_last>[+-])?)?$")


def parse_frontmatter_block(block: str) -> dict:
    out: dict = {}
    lines = block.split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip() or line.lstrip().startswith("#") or line[:1].isspace():
            i += 1
            continue
        if ":" not in line:
            i += 1
            continue
        key, _, rest = line.partition(":")
        key = key.strip()
        rest = rest.strip()
        header = BLOCK_SCALAR.match(rest) if rest[:1] in ("|", ">") else None
        if header:
            folded = header.group("style") == ">"
            # The indentation indicator is how many columns of each line belong
            # to the layout rather than to the text, so it is taken off rather
            # than guessed at. Without one the block is stripped, which is what
            # every block scalar in the wild is written to survive.
            dedent = int(header.group("indent") or header.group("indent_first") or 0)
            body, i = _consume_indented(lines, i + 1, dedent)
            out[key] = (" ".join(x.strip() for x in body) if folded else "\n".join(body)).strip()
            continue
        if rest == "":
            body, j = _consume_indented(lines, i + 1)
            if body:
                nested = {}
                for sub in body:
                    if ":" in sub:
                        k2, _, v2 = sub.partition(":")
                        nested[k2.strip()] = _unquote(v2.strip())
                out[key] = nested
                i = j
                continue
            out[key] = ""
            i += 1
            continue
        # A plain scalar may still continue onto following indented lines.
        cont, j = _consume_indented(lines, i + 1)
        value = rest if not cont else rest + " " + " ".join(x.strip() for x in cont)
        out[key] = _unquote(value.strip())
        i = j if cont else i + 1
    return out


def has_unquoted_colon(block: str) -> bool:
    """True when a plain scalar carries a bare `: `, which is invalid YAML.

    We read such a file anyway, but a stricter agent may drop the whole
    frontmatter, so the row is worth marking.
    """
    for line in block.split("\n"):
        if not line or line[:1].isspace() or line.lstrip().startswith("#"):
            continue
        _, sep, rest = line.partition(":")
        if not sep:
            continue
        rest = rest.strip()
        if not rest or rest[:1] in "\"'|>":
            continue
        if ": " in rest:
            return True
    return False


def _consume_indented(lines: list[str], start: int, dedent: int = 0) -> tuple[list[str], int]:
    """The lines under a key, and where the next key begins.

    `dedent` is a block scalar's own indentation indicator, and only that: with
    one, exactly that many columns come off each line and whatever is left is the
    author's text, which is what somebody writing `>2` asked for. Without one
    every line is stripped, which is how the indentation of a block scalar that
    declares none has always been guessed here, and the guess is right for every
    such file on this machine.
    """
    body: list[str] = []
    i = start
    while i < len(lines):
        line = lines[i]
        if line.strip() and not line[:1].isspace():
            break
        if not line.strip():
            body.append("")
        elif dedent and line[:dedent].isspace():
            body.append(line[dedent:])
        else:
            body.append(line.strip())
        i += 1
    while body and not body[-1]:
        body.pop()
    return body, i


def _unquote(v: str) -> str:
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
        return v[1:-1]
    return v


